# ================================================================
# PYTHON
# ================================================================
# Byte-compiled / optimized / DLL files
*.pyc
*.pyo
*.pyd
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ================================================================
# VIRTUAL ENVIRONMENTS
# ================================================================
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ================================================================
# DJANGO
# ================================================================
# SQLite databases
*.db
*.sqlite3
db.sqlite3
database/*.db
database/*.sqlite3

# Django static files (collected by collectstatic)
/staticfiles/

# Note: /static/ directory contains source static files (Bootstrap, jQuery, custom CSS/JS)
# and MUST be committed to repository (NFR3: no CDN dependencies)

# Django media files
/media/

# Django secret key and local settings
.env
.env.local
local_settings.py

# Django migrations (keep in git, but exclude if needed)
# */migrations/*.py
# !*/migrations/__init__.py

# Django logs
*.log
samplify.log
logs/*.log

# ================================================================
# BINARIES AND EXECUTABLES
# ================================================================
/bin/
*.exe
*.dll
*.so
*.dylib

# FFmpeg binaries (downloaded by setup script)
bin/windows/
bin/macos/
bin/linux/

# ================================================================
# IDE AND EDITORS
# ================================================================
# PyCharm
.idea/
!.idea/vcs.xml
.idea/workspace.xml

# VSCode
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.*.swp

# Emacs
*~
\#*\#
.\#*

# ================================================================
# TESTING
# ================================================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ================================================================
# EPHEMERAL DEVELOPMENT ARTIFACTS (NFR15)
# ================================================================
# Philosophy: "Ignore what can be regenerated from source of truth"
# Based on Twelve-Factor App methodology and Git repository hygiene standards
# See: docs/architecture/coding-standards.md - Development Artifact Lifecycle Management

# Generic ephemeral artifacts
*.tmp
*.temp
*.bak
*.old
.DS_Store
Thumbs.db

# Agent-generated ephemeral artifacts
debug_*.py
test_*.py
quick_test_*.py
scratch_*.py
migrate_*.py
fix_*.py
profile_*.py
benchmark_*.py

# Derived profiling artifacts (can be regenerated by re-running profiler on source)
*.prof
profile_*.txt
benchmark_*.csv
performance_*.json

# Agent execution logs (can be regenerated by re-running agent)
.ai/debug-log.md
.ai/*.log
.ai/trace_*.md

# Generated test media (can be regenerated or re-downloaded)
media/test/
media/temp/
media/debug/

# Ephemeral exploration code (promote to source of truth OR delete)
prototype_*.py
experiment_*.py

# ================================================================
# DEPENDENCIES
# ================================================================
node_modules/

# ================================================================
# PROJECT-SPECIFIC
# ================================================================
# Media test files (local only - too large for git)
# Allow directory structure but exclude all contents except README and .gitkeep
media/*
!media/.gitkeep
!media/README.md

# Test output directory (generated by test suite)
# Contains processed files from CR1/CR2 validation tests
test_output/
!test_output/.gitkeep
